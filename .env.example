# 관리자 로그인 비밀번호. 반드시 운영 환경에서는 원하는 값으로 바꿔서
# .env.local 파일에 설정하세요 (설정하지 않으면 기본값 "ableenglish" 사용).
ABE_ADMIN_PASSWORD=ableenglish

# HTTPS 뒤에 배포한 경우에만 true로 설정하세요.
# (HTTPS 없이 true로 설정하면 브라우저가 로그인 쿠키 저장을 거부해 로그인이 계속 풀립니다.)
# Vercel처럼 HTTPS로 서비스되는 곳에 배포한다면 true로 설정하세요.
ABE_FORCE_SECURE_COOKIE=false

# Turso(호스팅 SQLite) 연결 정보. Vercel 같은 서버리스 환경은 로컬 파일이 유지되지
# 않으므로 배포 시에는 반드시 설정해야 합니다. 로컬 개발 중에는 비워두면
# data/academy.db 로컬 파일을 그대로 사용합니다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
